# Конфиг хука hoster-dns-hook.sh.
# Скопировать в /etc/letsencrypt/hoster.env, заполнить и chmod 600 (владелец root).

# Ключи сервисного API-аккаунта из личного кабинета hoster.by (раздел API).
# Токен создаётся скриптом на каждый запуск, долгоживущий хранить не нужно.
ACCESS_KEY=''
SECRET_KEY=''

# Либо готовый Access-Token, если он у вас long-lived:
#ACCESS_TOKEN=''

# Опционально: зафиксировать orderId DNS-услуги для домена
# (иначе хук сам найдёт его в GET /dns/orders по CERTBOT_DOMAIN):
#HOSTER_ORDER_ID=12345
